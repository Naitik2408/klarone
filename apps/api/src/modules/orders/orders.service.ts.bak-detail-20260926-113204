import {
  BadRequestException,
  Injectable,
  NotFoundException,
} from "@nestjs/common";

import { PrismaService } from "../../database/prisma.service";
import type { AuthenticatedCustomer } from "../customer-auth/types/customer-session.types";

@Injectable()
export class OrdersService {
  constructor(
    private readonly prisma: PrismaService,
  ) {}

  async listOrders(
    customer: AuthenticatedCustomer,
  ) {
    const customerId =
      this.toBigInt(
        customer.customerId,
      );

    const orders =
      await this.prisma.order.findMany({
        where: {
          customerId,
        },
        orderBy: {
          createdAt: "desc",
        },
        include: {
          items: {
            orderBy: {
              id: "asc",
            },
            select: {
              id: true,
              productVariantId: true,
              productName: true,
              sku: true,
              quantity: true,
              unitPrice: true,
              discountAmount: true,
              taxAmount: true,
              totalAmount: true,
            },
          },
        },
      });

    return {
      orders: orders.map(
        (order) =>
          this.serializeOrder(
            order,
          ),
      ),
    };
  }

  async getOrder(
    customer: AuthenticatedCustomer,
    orderNumber: string,
  ) {
    const customerId =
      this.toBigInt(
        customer.customerId,
      );

    const normalizedOrderNumber =
      orderNumber.trim();

    if (
      normalizedOrderNumber.length ===
      0
    ) {
      throw new NotFoundException(
        "Order not found",
      );
    }

    const order =
      await this.prisma.order.findFirst({
        where: {
          customerId,
          orderNumber:
            normalizedOrderNumber,
        },
        include: {
          items: {
            orderBy: {
              id: "asc",
            },
            select: {
              id: true,
              productVariantId: true,
              productName: true,
              sku: true,
              quantity: true,
              unitPrice: true,
              discountAmount: true,
              taxAmount: true,
              totalAmount: true,
              productVariant: {
                select: {
                  variantName: true,
                  ramGb: true,
                  storageGb: true,
                  operatingSystem: true,
                  currency: true,
                  product: {
                    select: {
                      id: true,
                      name: true,
                      slug: true,
                      brand: {
                        select: {
                          id: true,
                          name: true,
                          slug: true,
                        },
                      },
                    },
                  },
                },
              },
            },
          },
          payments: {
            orderBy: {
              createdAt: "desc",
            },
            select: {
              id: true,
              provider: true,
              providerOrderId: true,
              amount: true,
              currency: true,
              status: true,
              createdAt: true,
            },
          },
          statusHistory: {
            orderBy: {
              createdAt: "asc",
            },
            select: {
              id: true,
              oldStatus: true,
              newStatus: true,
              notes: true,
              createdAt: true,
            },
          },
        },
      });

    if (!order) {
      throw new NotFoundException(
        "Order not found",
      );
    }

    return {
      order: this.serializeOrder(
        order,
      ),
    };
  }


  async listStaffOrders(params: {
    search?: string;
    status?: string;
    paymentStatus?: string;
    fulfillmentStatus?: string;
    page?: number;
    pageSize?: number;
  }) {
    const page = Math.max(params.page ?? 1, 1);
    const pageSize = Math.min(
      Math.max(params.pageSize ?? 20, 1),
      100,
    );

    const search = params.search?.trim();
    const status = params.status?.trim().toUpperCase();
    const paymentStatus = params.paymentStatus?.trim().toUpperCase();
    const fulfillmentStatus = params.fulfillmentStatus?.trim().toUpperCase();

    const where = {
      ...(status ? { status } : {}),
      ...(paymentStatus ? { paymentStatus } : {}),
      ...(fulfillmentStatus ? { fulfillmentStatus } : {}),
      ...(search
        ? {
            OR: [
              {
                orderNumber: {
                  contains: search,
                  mode: "insensitive" as const,
                },
              },
              {
                customer: {
                  person: {
                    firstName: {
                      contains: search,
                      mode: "insensitive" as const,
                    },
                  },
                },
              },
              {
                customer: {
                  person: {
                    lastName: {
                      contains: search,
                      mode: "insensitive" as const,
                    },
                  },
                },
              },
              {
                customer: {
                  person: {
                    email: {
                      contains: search,
                      mode: "insensitive" as const,
                    },
                  },
                },
              },
              {
                customer: {
                  person: {
                    phone: {
                      contains: search,
                      mode: "insensitive" as const,
                    },
                  },
                },
              },
            ],
          }
        : {}),
    };

    const [orders, total] = await Promise.all([
      this.prisma.order.findMany({
        where,
        orderBy: [
          { createdAt: "desc" },
          { id: "desc" },
        ],
        skip: (page - 1) * pageSize,
        take: pageSize,
        select: {
          id: true,
          orderNumber: true,
          status: true,
          paymentStatus: true,
          fulfillmentStatus: true,
          subtotal: true,
          discountAmount: true,
          shippingAmount: true,
          taxAmount: true,
          totalAmount: true,
          currency: true,
          billingAddressId: true,
          shippingAddressId: true,
          recommendationSessionId: true,
          placedAt: true,
          createdAt: true,
          updatedAt: true,
          customer: {
            select: {
              id: true,
              customerCode: true,
              person: {
                select: {
                  firstName: true,
                  middleName: true,
                  lastName: true,
                  email: true,
                  phone: true,
                },
              },
            },
          },
          items: {
            orderBy: { id: "asc" },
            select: {
              id: true,
              productVariantId: true,
              productName: true,
              sku: true,
              quantity: true,
              unitPrice: true,
              discountAmount: true,
              taxAmount: true,
              totalAmount: true,
            },
          },
          _count: {
            select: {
              items: true,
            },
          },
        },
      }),
      this.prisma.order.count({ where }),
    ]);

    return {
      orders: orders.map((order) =>
        this.serializeOrder(order),
      ),
      pagination: {
        page,
        pageSize,
        total,
        totalPages: Math.ceil(total / pageSize),
      },
    };
  }

  async getStaffOrder(orderNumber: string) {
    const normalizedOrderNumber = orderNumber.trim();

    if (!normalizedOrderNumber) {
      throw new NotFoundException("Order not found");
    }

    const order = await this.prisma.order.findUnique({
      where: {
        orderNumber: normalizedOrderNumber,
      },
      include: {
        customer: {
          select: {
            id: true,
            customerCode: true,
            person: {
              select: {
                firstName: true,
                middleName: true,
                lastName: true,
                email: true,
                phone: true,
              },
            },
          },
        },
        billingAddress: true,
        shippingAddress: true,
        items: {
          orderBy: { id: "asc" },
          select: {
            id: true,
            productVariantId: true,
            productName: true,
            sku: true,
            quantity: true,
            unitPrice: true,
            discountAmount: true,
            taxAmount: true,
            totalAmount: true,
            productVariant: {
              select: {
                id: true,
                variantName: true,
                ramGb: true,
                storageGb: true,
                operatingSystem: true,
                currency: true,
                product: {
                  select: {
                    id: true,
                    name: true,
                    slug: true,
                    brand: {
                      select: {
                        id: true,
                        name: true,
                        slug: true,
                      },
                    },
                  },
                },
              },
            },
          },
        },
        payments: {
          orderBy: { createdAt: "desc" },
          select: {
            id: true,
            provider: true,
            providerOrderId: true,
            providerPaymentId: true,
            paymentMethod: true,
            amount: true,
            currency: true,
            status: true,
            paidAt: true,
            createdAt: true,
          },
        },
        statusHistory: {
          orderBy: { createdAt: "asc" },
          select: {
            id: true,
            oldStatus: true,
            newStatus: true,
            notes: true,
            createdAt: true,

          },
        },
        shipments: {
          orderBy: { createdAt: "desc" },
          select: {
            id: true,
            carrier: true,
            trackingNumber: true,
            status: true,
            shippedAt: true,
            deliveredAt: true,
            createdAt: true,
            updatedAt: true,
          },
        },
        refunds: {
          orderBy: { createdAt: "desc" },
          select: {
            id: true,
            paymentId: true,
            amount: true,
            reason: true,
            providerRefundId: true,
            status: true,
            createdAt: true,
            completedAt: true,
          },
        },
      },
    });

    if (!order) {
      throw new NotFoundException("Order not found");
    }

    return {
      order: this.serializeOrder(order),
    };
  }

  async updateStaffOrderStatus(
    orderNumber: string,
    input: {
      status: string;
      notes?: string;
    },
    changedByUserId: bigint,
  ) {
    const normalizedOrderNumber = orderNumber.trim();
    const nextStatus = input.status.trim().toUpperCase();
    const notes = input.notes?.trim() || null;

    if (!normalizedOrderNumber) {
      throw new NotFoundException("Order not found");
    }

    if (!nextStatus) {
      throw new BadRequestException("Order status is required.");
    }

    if (nextStatus.length > 40) {
      throw new BadRequestException("Order status is too long.");
    }

    if (notes && notes.length > 500) {
      throw new BadRequestException("Order notes cannot exceed 500 characters.");
    }

    const updated = await this.prisma.$transaction(async (tx) => {
      const current = await tx.order.findUnique({
        where: { orderNumber: normalizedOrderNumber },
        select: {
          id: true,
          orderNumber: true,
          status: true,
          paymentStatus: true,
          fulfillmentStatus: true,
          totalAmount: true,
          currency: true,
        },
      });

      if (!current) {
        throw new NotFoundException("Order not found");
      }

      if (current.status === nextStatus) {
        throw new BadRequestException(
          `Order is already ${nextStatus}.`,
        );
      }

      const order = await tx.order.update({
        where: { id: current.id },
        data: {
          status: nextStatus,
        },
        select: {
          id: true,
          orderNumber: true,
          status: true,
          paymentStatus: true,
          fulfillmentStatus: true,
          subtotal: true,
          discountAmount: true,
          shippingAmount: true,
          taxAmount: true,
          totalAmount: true,
          currency: true,
          billingAddressId: true,
          shippingAddressId: true,
          recommendationSessionId: true,
          placedAt: true,
          createdAt: true,
          updatedAt: true,
          items: {
            orderBy: { id: "asc" },
            select: {
              id: true,
              productVariantId: true,
              productName: true,
              sku: true,
              quantity: true,
              unitPrice: true,
              discountAmount: true,
              taxAmount: true,
              totalAmount: true,
            },
          },
        },
      });

      await tx.orderStatusHistory.create({
        data: {
          orderId: current.id,
          oldStatus: current.status,
          newStatus: nextStatus,
          changedByUserId,
          notes,
        },
      });

      return order;
    });

    return {
      order: this.serializeOrder(updated),
    };
  }
  private serializeOrder(
    order: {
      id: bigint;
      orderNumber: string;
      status: string;
      paymentStatus: string;
      fulfillmentStatus: string;
      subtotal: unknown;
      discountAmount: unknown;
      shippingAmount: unknown;
      taxAmount: unknown;
      totalAmount: unknown;
      currency: string;
      billingAddressId: bigint | null;
      shippingAddressId: bigint | null;
      recommendationSessionId:
        string | null;
      placedAt: Date | null;
      createdAt: Date;
      updatedAt: Date;
      customer?: {
        id: bigint;
        customerCode: string;
        person: {
          firstName: string;
          middleName: string | null;
          lastName: string | null;
          email: string | null;
          phone: string | null;
        };
      };
      _count?: {
        items: number;
      };
      items: Array<{
        id: bigint;
        productVariantId:
          bigint | null;
        productName: string;
        sku: string;
        quantity: number;
        unitPrice: unknown;
        discountAmount: unknown;
        taxAmount: unknown;
        totalAmount: unknown;
        productVariant?: {
          variantName:
            string | null;
          ramGb: number | null;
          storageGb: number | null;
          operatingSystem:
            string | null;
          currency: string;
          product: {
            id: bigint;
            name: string;
            slug: string;
            brand: {
              id: number;
              name: string;
              slug: string;
            };
          };
        } | null;
      }>;
      payments?: Array<{
        id: bigint;
        provider: string;
        providerOrderId:
          string | null;
        amount: unknown;
        currency: string;
        status: string;
        createdAt: Date;
      }>;
      statusHistory?: Array<{
        id: bigint;
        oldStatus: string | null;
        newStatus: string;
        notes: string | null;
        createdAt: Date;
      }>;
    },
  ) {
    return {
      ...(order._count
        ? {
            _count: {
              items: order._count.items,
            },
          }
        : {}),
      id: order.id.toString(),
      orderNumber: order.orderNumber,
      status: order.status,
      paymentStatus:
        order.paymentStatus,
      fulfillmentStatus:
        order.fulfillmentStatus,
      subtotal:
        String(order.subtotal),
      discountAmount:
        String(
          order.discountAmount,
        ),
      shippingAmount:
        String(
          order.shippingAmount,
        ),
      taxAmount:
        String(order.taxAmount),
      totalAmount:
        String(order.totalAmount),
      currency: order.currency,
      billingAddressId:
        order.billingAddressId?.toString() ??
        null,
      shippingAddressId:
        order.shippingAddressId?.toString() ??
        null,
      recommendationSessionId:
        order.recommendationSessionId,
      placedAt:
        order.placedAt?.toISOString() ??
        null,
      createdAt:
        order.createdAt.toISOString(),
      updatedAt:
        order.updatedAt.toISOString(),
      ...(order.customer
        ? {
            customer: {
              id: order.customer.id.toString(),
              customerCode: order.customer.customerCode,
              person: {
                firstName: order.customer.person.firstName,
                middleName: order.customer.person.middleName,
                lastName: order.customer.person.lastName,
                email: order.customer.person.email,
                phone: order.customer.person.phone,
              },
            },
          }
        : {}),
      items: order.items.map(
        (item) => ({
          id:
            item.id.toString(),
          productVariantId:
            item.productVariantId?.toString() ??
            null,
          productName:
            item.productName,
          sku: item.sku,
          quantity:
            item.quantity,
          unitPrice:
            String(item.unitPrice),
          discountAmount:
            String(
              item.discountAmount,
            ),
          taxAmount:
            String(item.taxAmount),
          totalAmount:
            String(item.totalAmount),
          productVariant:
            item.productVariant
              ? {
                  id:
                    item.productVariant
                      .product
                      .id.toString(),
                  variantName:
                    item.productVariant
                      .variantName,
                  ramGb:
                    item.productVariant
                      .ramGb,
                  storageGb:
                    item.productVariant
                      .storageGb,
                  operatingSystem:
                    item.productVariant
                      .operatingSystem,
                  currency:
                    item.productVariant
                      .currency,
                  product: {
                    id:
                      item.productVariant
                        .product
                        .id.toString(),
                    name:
                      item.productVariant
                        .product
                        .name,
                    slug:
                      item.productVariant
                        .product
                        .slug,
                    brand:
                      item.productVariant
                        .product
                        .brand,
                  },
                }
              : null,
        }),
      ),
      payments:
        order.payments?.map(
          (payment) => ({
            id:
              payment.id.toString(),
            provider:
              payment.provider,
            providerOrderId:
              payment.providerOrderId,
            amount:
              String(payment.amount),
            currency:
              payment.currency,
            status:
              payment.status,
            createdAt:
              payment.createdAt.toISOString(),
          }),
        ) ?? [],
      statusHistory:
        order.statusHistory?.map(
          (history) => ({
            id:
              history.id.toString(),
            oldStatus:
              history.oldStatus,
            newStatus:
              history.newStatus,
            notes:
              history.notes,
            createdAt:
              history.createdAt.toISOString(),
          }),
        ) ?? [],
    };
  }

  private toBigInt(
    value: string,
  ): bigint {
    try {
      const result = BigInt(value);

      if (result <= 0n) {
        throw new Error(
          "Must be positive",
        );
      }

      return result;
    } catch {
      throw new NotFoundException(
        "Customer not found",
      );
    }
  }
}





