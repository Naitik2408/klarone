import {
  Injectable,
  NotFoundException,
} from "@nestjs/common";
import { PrismaService } from "../../database/prisma.service";
import { toJsonSafe } from "../../common/serialization/json-safe";

@Injectable()
export class CatalogueService {
  constructor(private readonly prisma: PrismaService) {}

  async findProducts(params: {
    search?: string;
    brandSlug?: string;
    categorySlug?: string;
    page?: number;
    pageSize?: number;
  }) {
    const page = Math.max(params.page ?? 1, 1);
    const pageSize = Math.min(
      Math.max(params.pageSize ?? 24, 1),
      100,
    );

    const search = params.search?.trim();

    const where = {
      status: "PUBLISHED",
      ...(search
        ? {
            OR: [
              {
                name: {
                  contains: search,
                  mode: "insensitive" as const,
                },
              },
              {
                shortDescription: {
                  contains: search,
                  mode: "insensitive" as const,
                },
              },
              {
                brand: {
                  name: {
                    contains: search,
                    mode: "insensitive" as const,
                  },
                },
              },
            ],
          }
        : {}),
      ...(params.brandSlug
        ? {
            brand: {
              slug: params.brandSlug,
              status: "ACTIVE",
            },
          }
        : {}),
      ...(params.categorySlug
        ? {
            category: {
              slug: params.categorySlug,
              status: "ACTIVE",
            },
          }
        : {}),
    };

    const [items, total] = await Promise.all([
      this.prisma.product.findMany({
        where,
        orderBy: {
          name: "asc",
        },
        skip: (page - 1) * pageSize,
        take: pageSize,
        select: {
          id: true,
          name: true,
          slug: true,
          shortDescription: true,
          productType: true,

          brand: {
            select: {
              id: true,
              name: true,
              slug: true,
            },
          },

          category: {
            select: {
              id: true,
              name: true,
              slug: true,
            },
          },

          media: {
            where: {
              isPrimary: true,
            },
            orderBy: {
              displayOrder: "asc",
            },
            take: 1,
            select: {
              id: true,
              mediaType: true,
              url: true,
              storageKey: true,
              altText: true,
            },
          },

          variants: {
            where: {
              status: "ACTIVE",
            },
            orderBy: {
              sellingPrice: "asc",
            },
            take: 1,
            select: {
              id: true,
              sku: true,
              variantName: true,
              ramGb: true,
              storageGb: true,
              operatingSystem: true,
              sellingPrice: true,
              compareAtPrice: true,
              currency: true,
            },
          },
        },
      }),

      this.prisma.product.count({
        where,
      }),
    ]);

    return toJsonSafe({
      items,
      pagination: {
        page,
        pageSize,
        total,
        totalPages: Math.ceil(total / pageSize),
      },
    });
  }

  async findProductBySlug(slug: string) {
    const product = await this.prisma.product.findUnique({
      where: {
        slug,
      },
      select: {
        id: true,
        name: true,
        slug: true,
        modelNumber: true,
        manufacturerPartNumber: true,
        shortDescription: true,
        description: true,
        productType: true,
        status: true,

        brand: {
          select: {
            id: true,
            name: true,
            slug: true,
            logoUrl: true,
          },
        },

        category: {
          select: {
            id: true,
            name: true,
            slug: true,
          },
        },

        media: {
          orderBy: {
            displayOrder: "asc",
          },
          select: {
            id: true,
            mediaType: true,
            url: true,
            storageKey: true,
            altText: true,
            width: true,
            height: true,
            displayOrder: true,
            isPrimary: true,
          },
        },

        variants: {
          where: {
            status: "ACTIVE",
          },
          orderBy: {
            sellingPrice: "asc",
          },
          select: {
            id: true,
            sku: true,
            variantName: true,
            color: true,
            ramGb: true,
            storageGb: true,
            operatingSystem: true,
            basePrice: true,
            sellingPrice: true,
            compareAtPrice: true,
            currency: true,
            warrantyMonths: true,

            specification: true,

            ports: {
              orderBy: {
                portType: "asc",
              },
              select: {
                id: true,
                portType: true,
                quantity: true,
                version: true,
                supportsCharging: true,
                supportsDisplay: true,
              },
            },

            features: {
              orderBy: {
                featureType: "asc",
              },
              select: {
                id: true,
                featureType: true,
                featureName: true,
                description: true,
                score: true,
              },
            },
          },
        },
      },
    });

    if (!product || product.status !== "PUBLISHED") {
      throw new NotFoundException("Product not found");
    }

    return toJsonSafe(product);
  }

  async findBrands() {
    const brands = await this.prisma.brand.findMany({
      where: {
        status: "ACTIVE",
      },
      orderBy: {
        name: "asc",
      },
      select: {
        id: true,
        name: true,
        slug: true,
        logoUrl: true,
      },
    });

    return toJsonSafe(brands);
  }

  async findCategories() {
    const categories = await this.prisma.category.findMany({
      where: {
        status: "ACTIVE",
      },
      orderBy: [
        {
          displayOrder: "asc",
        },
        {
          name: "asc",
        },
      ],
      select: {
        id: true,
        parentId: true,
        name: true,
        slug: true,
        description: true,
      },
    });

    return toJsonSafe(categories);
  }
}
